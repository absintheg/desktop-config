#!/usr/bin/env bash

query=$(printf "" | noctalia dmenu --prompt "Search Youtube") || exit

if [[ -z "$query" ]]; then
	exit
fi

query_encoded=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote_plus(sys.argv[1]))" "$query")

xdg-open "https://www.youtube.com/results?search_query=$query_encoded"
